{
  "manifest_version": 3,
  "name": "AeroPanel Video FPS",
  "version": "1.1.3",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "视频帧数据 → AeroPanel 桌面浮窗"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "meter.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
